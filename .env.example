# Copy ke .env dan isi sesuai kebutuhan. .env tidak ter-commit (lihat .gitignore).
# Di Pterodactyl: set ini di tab "Variables" / "Startup" panel, bukan via file .env.

# Port server. Pterodactyl Node.js egg pakai SERVER_PORT — server.js mendukung keduanya.
PORT=3000
# SERVER_PORT=3000

# CORS — domain frontend yang boleh akses API. Pisahkan dengan koma.
# Gunakan "*" hanya untuk development.
ALLOWED_ORIGINS=https://your-frontend.example.com

# API key. Kalau di-set, semua /api/* butuh header `X-API-Key: <value>`.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=ganti-dengan-string-random-yang-panjang

# Rate limit inbound per IP per menit.
RATE_LIMIT=60

# Max request paralel ke Otakudesu (global, bukan per-user).
# Naikkan kalau traffic tinggi & cache sudah panas, turunkan kalau IP kena ban.
OUTBOUND_CONCURRENCY=3

# Optional: proxy untuk outbound request ke Otakudesu.
# Butuh: npm install https-proxy-agent
# Format: http://user:pass@host:port atau http://host:port
# HTTP_PROXY=http://user:pass@proxy.example.com:8080
